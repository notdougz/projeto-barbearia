web: echo '=== Iniciando aplicação ===' && python manage.py migrate --noinput && echo '=== Migrações aplicadas ===' && python manage.py collectstatic --noinput --clear && echo '=== Arquivos estáticos coletados ===' && python setup.py && echo '=== Setup concluído ===' && echo '=== Iniciando Gunicorn na porta ${PORT:-8000} ===' && gunicorn barbearia.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 3 --timeout 120 --log-level info --access-logfile - --error-logfile -